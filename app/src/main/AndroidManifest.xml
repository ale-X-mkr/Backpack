<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- GPS chip only. COARSE is declared because Android 12+ requires it
         alongside FINE; the app never uses network/Wi-Fi location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Navigation keeps running with the screen off (visible notification).
         No ACCESS_BACKGROUND_LOCATION: the service is started from the
         open app, which Android allows for a location foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".BackpackApp"
        android:allowBackup="false"
        android:label="Backpack"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Backpack"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 1.0.1: Backpack can be chosen as the navigation app. Other apps
                 hand over a place with these links; Backpack puts it as the
                 destination and shows the route (you press Go). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="google.navigation" />
            </intent-filter>
            <!-- Google Maps web links with the place in them (Android 12+: allow
                 them once in Backpack's app info > Open by default). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="maps.google.com" />
                <data android:host="maps.google.fr" />
                <data android:host="maps.google.de" />
                <data android:host="maps.google.es" />
                <data android:host="maps.google.it" />
                <data android:host="maps.google.co.uk" />
                <data android:host="maps.google.ch" />
                <data android:host="maps.google.be" />
                <data android:host="maps.google.nl" />
                <data android:host="maps.google.at" />
                <data android:host="maps.google.pt" />
                <data android:host="maps.google.no" />
                <data android:host="maps.google.se" />
                <data android:host="maps.google.dk" />
                <data android:host="maps.google.fi" />
                <data android:host="maps.google.pl" />
                <data android:host="maps.google.cz" />
                <data android:host="maps.google.ie" />
                <data android:host="maps.google.lu" />
                <data android:host="maps.google.ca" />
                <data android:host="maps.google.com.au" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="google.com" />
                <data android:host="www.google.com" />
                <data android:host="google.fr" />
                <data android:host="www.google.fr" />
                <data android:host="google.de" />
                <data android:host="www.google.de" />
                <data android:host="google.es" />
                <data android:host="www.google.es" />
                <data android:host="google.it" />
                <data android:host="www.google.it" />
                <data android:host="google.co.uk" />
                <data android:host="www.google.co.uk" />
                <data android:host="google.ch" />
                <data android:host="www.google.ch" />
                <data android:host="google.be" />
                <data android:host="www.google.be" />
                <data android:host="google.nl" />
                <data android:host="www.google.nl" />
                <data android:host="google.at" />
                <data android:host="www.google.at" />
                <data android:host="google.pt" />
                <data android:host="www.google.pt" />
                <data android:host="google.no" />
                <data android:host="www.google.no" />
                <data android:host="google.se" />
                <data android:host="www.google.se" />
                <data android:host="google.dk" />
                <data android:host="www.google.dk" />
                <data android:host="google.fi" />
                <data android:host="www.google.fi" />
                <data android:host="google.pl" />
                <data android:host="www.google.pl" />
                <data android:host="google.cz" />
                <data android:host="www.google.cz" />
                <data android:host="google.ie" />
                <data android:host="www.google.ie" />
                <data android:host="google.lu" />
                <data android:host="www.google.lu" />
                <data android:host="google.ca" />
                <data android:host="www.google.ca" />
                <data android:host="google.com.au" />
                <data android:host="www.google.com.au" />
                <data android:pathPrefix="/maps" />
            </intent-filter>
        </activity>

        <service
            android:name=".nav.NavigationService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>
