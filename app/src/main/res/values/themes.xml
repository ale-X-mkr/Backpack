<resources>
    <!-- AppCompat only: Google's Material Components library removed. -->
    <style name="Theme.Backpack" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rg_active</item>
        <item name="colorPrimaryDark">@color/rg_window_bg</item>
        <item name="colorAccent">@color/rg_active</item>
        <item name="colorControlActivated">@color/rg_active</item>
        <item name="android:windowBackground">@color/rg_window_bg</item>
        <item name="android:textColorPrimary">@color/rg_text</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="fontFamily">sans-serif-condensed</item>
    </style>

    <style name="Theme.Backpack.Popup" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorAccent">@color/rg_active</item>
        <item name="colorControlActivated">@color/rg_active</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>
</resources>
