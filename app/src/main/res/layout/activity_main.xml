<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 1.0.2: protected zones. Transparent, they catch taps that miss a
         button by a little, so the map under the controls never gets an
         unwanted tap (destination, stop). Sized in code with the columns. -->
    <View
        android:id="@+id/guard_left"
        android:layout_width="88dp"
        android:layout_height="230dp"
        android:layout_gravity="top|start"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/guard_right"
        android:layout_width="56dp"
        android:layout_height="230dp"
        android:layout_gravity="top|end"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/guard_bottom"
        android:layout_width="match_parent"
        android:layout_height="136dp"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- 1.0.4: the instruction box, top centre, 80 % of the old width (set in
         code). Navigating: turn row + distance/arrival/cost line; planning:
         only that line. Speed circle at its right end (driving). -->
    <LinearLayout
        android:id="@+id/nav_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="@drawable/nav_bar_background"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:clickable="true"
        android:visibility="gone">

    <LinearLayout
        android:id="@+id/nav_instruction_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/nav_instruction_icon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/nav_icon_backdrop"
            android:padding="4dp"
            android:src="@drawable/ic_nav_straight"
            android:visibility="gone" />

        <TextView
            android:id="@+id/nav_distance_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.01" />

        <TextView
            android:id="@+id/status_strip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:maxLines="2"
            android:ellipsize="end"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.01" />

    </LinearLayout>

        <!-- Last line of the box: distance, arrival, cost (smaller, its own colour). -->
        <LinearLayout
            android:id="@+id/route_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/route_info_dist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text=""
                android:textColor="@color/eta_line_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:id="@+id/route_info_eta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text=""
                android:textColor="@color/eta_line_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:id="@+id/route_info_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/eta_line_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed" />

        </LinearLayout>

    </LinearLayout>

    <!-- ===== ZONE: left column, trip setup (mirrors the right column, same
         rows 113 / 166 / 219 / 272dp): travel mode (toll button to its right
         when driving), urgency, POI categories; "resume" under them. ===== -->

    <LinearLayout
        android:id="@+id/mode_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="113dp"
        android:layout_marginStart="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="38dp"
            android:clipChildren="false">

            <ImageButton
                android:id="@+id/mode_toggle_button"
                android:scaleType="fitCenter"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="start"
                android:src="@drawable/ic_mode_walking"
                android:background="@drawable/icon_backdrop"
                android:padding="4dp"
                android:contentDescription="Travel mode"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

            <ImageButton
                android:id="@+id/toll_toggle"
                android:scaleType="fitCenter"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="39dp"
                android:src="@drawable/ic_toll_on"
                android:background="@drawable/icon_backdrop"
                android:padding="3dp"
                android:contentDescription="@string/avoid_tolls_label"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:visibility="gone" />

        </FrameLayout>

        <ImageButton
            android:id="@+id/urgency_button"
            android:scaleType="fitCenter"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/ic_urgency_weekend"
            android:background="@drawable/icon_backdrop"
            android:padding="4dp"
            android:contentDescription="@string/urgency_label"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

        <!-- POI categories; with Sights, the small "around me / map centre"
             button to its right (1.0.7). -->
        <FrameLayout
            android:id="@+id/poi_row"
            android:layout_width="72dp"
            android:layout_height="38dp"
            android:layout_marginTop="15dp"
            android:clipChildren="false">

            <ImageButton
                android:id="@+id/poi_toggle_button"
                android:scaleType="fitCenter"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="start"
                android:src="@drawable/ic_poi_toggle"
                android:background="@drawable/icon_backdrop"
                android:padding="4dp"
                android:contentDescription="Points of interest"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

            <ImageButton
                android:id="@+id/sights_origin_button"
                android:scaleType="fitCenter"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="39dp"
                android:src="@drawable/ic_location_marker"
                android:background="@drawable/icon_backdrop"
                android:padding="4dp"
                android:contentDescription="Sights around me or the map centre"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- ===== ZONE: right column ===== -->

    <!-- 2: center on my location -->
    <ImageButton
        android:id="@+id/locate_button"
        android:scaleType="fitCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="113dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_location_marker"
        android:background="@drawable/icon_backdrop"
        android:padding="4dp"
        android:contentDescription="@string/locate_button_label"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

    <!-- 3: add a stop -->
    <ImageButton
        android:id="@+id/waypoint_button"
        android:scaleType="fitCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="166dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_waypoint"
        android:background="@drawable/icon_backdrop"
        android:padding="4dp"
        android:contentDescription="Add a stop along the route"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

    <!-- 4-6: route preference, single cycling toggle -->
    <ImageButton
        android:id="@+id/preference_toggle_button"
        android:scaleType="fitCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="219dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_pref_fastest"
        android:background="@drawable/icon_backdrop"
        android:padding="4dp"
        android:contentDescription="Route preference"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

    <!-- Settings by category (opens on the Route page): route options,
         navigation view, speed, places, map, servers. -->
    <ImageButton
        android:id="@+id/route_options_button"
        android:scaleType="fitCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="272dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_route_options"
        android:background="@drawable/icon_backdrop"
        android:padding="6dp"
        android:contentDescription="Settings"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

    <!-- During navigation, left column under POI: another route from where you are. -->
    <ImageButton
        android:id="@+id/alt_route_button"
        android:scaleType="fitCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="219dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_alt_route"
        android:background="@drawable/icon_backdrop"
        android:padding="6dp"
        android:contentDescription="Find an alternative route"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:visibility="gone" />

    <!-- During navigation (in the add-stop slot): Drive view <-> Overview. -->
    <ImageButton
        android:id="@+id/overview_button"
        android:scaleType="fitCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="166dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_overview"
        android:background="@drawable/icon_backdrop"
        android:padding="6dp"
        android:contentDescription="Route overview"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:visibility="gone" />

    <!-- Left column, 4th row: back to the route before a detour, a replaced
         stop or "Go here" (kept until arrival). -->
    <ImageButton
        android:id="@+id/resume_button"
        android:scaleType="fitCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="325dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_resume_route"
        android:background="@drawable/icon_backdrop"
        android:padding="6dp"
        android:contentDescription="Resume previous route"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:visibility="gone" />

    <!-- Route chips A / B / C: one row at the top centre, between the two
         columns (under the instruction bar while navigating); scrolls
         sideways if they don't all fit. Top margin set in code. -->
    <HorizontalScrollView
        android:id="@+id/route_options_scroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/route_options_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:visibility="gone" />

    </HorizontalScrollView>

    <!-- ===== ZONE: communication area, bottom: buttons, route info, search
         bar, and the messages just over the search bar (over the route info
         while navigating, when the search bar is hidden). Errors above
         routine messages. Bottom margins set in code. ===== -->
    <LinearLayout
        android:id="@+id/message_band"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="68dp"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/error_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/message_bubble_background"
            android:textColor="@color/backpack_ink"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:maxLines="2"
            android:maxWidth="280dp"
            android:ellipsize="end"
            android:alpha="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/message_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/message_bubble_background"
            android:textColor="@color/backpack_ink"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:maxLines="2"
            android:maxWidth="280dp"
            android:ellipsize="end"
            android:alpha="0"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ===== ZONE: bottom-left, settings (swapped with speed sign) ===== -->


    <!-- ===== ZONE: bottom-right, live driving info ===== -->


    <!-- ===== ZONE: bottom-center, route result + primary action ===== -->




    <!-- ===== ZONE: bottom bar, navigation only: 3 equal slots (clear | go | speed),
         84dp tall (the speed widget with its limit sign fits inside, nothing
         clipped), centres 6 + 42 = 48dp above the bottom; empty slots keep
         their place. ===== -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false">

            <ImageButton
                android:id="@+id/clear_route_button"
                android:scaleType="fitCenter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_clear_route"
                android:background="@drawable/icon_backdrop"
                android:padding="3dp"
                android:contentDescription="Clear route"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false">

            <ImageButton
                android:id="@+id/nav_go_button"
                android:scaleType="fitCenter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_navigation_go"
                android:background="@drawable/icon_backdrop"
                android:padding="4dp"
                android:contentDescription="Start navigation"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Third slot left free: Go stays centred. -->
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Current speed circle at the top right: inside the instruction bar
         while navigating (right end, centred on its background), same spot
         otherwise. Ring colour = speed vs limit (rules unchanged); the road's
         limit sign at the circle's bottom-left, touching its ring. -->
    <FrameLayout
        android:id="@+id/speed_widget"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:clickable="true"
        android:clipChildren="false"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/speed_sign"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="top|end"
            android:background="@drawable/speed_sign_background">

            <TextView
                android:id="@+id/speed_sign_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="#FF1A1A1A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/speed_unit_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="9dp"
                android:includeFontPadding="false"
                android:text="km/h"
                android:textColor="#FF555555"
                android:textSize="9sp" />

        </FrameLayout>

        <TextView
            android:id="@+id/speed_limit_sign"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="11dp"
            android:layout_marginTop="37dp"
            android:background="@drawable/speed_limit_background"
            android:elevation="2dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#FF000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <!-- 1.0.4: floating search box, hidden until the magnifier is tapped;
         floats just over the keyboard, 70 % opaque. Margins set in code. -->
    <EditText
        android:id="@+id/search_input"
        android:layout_width="match_parent"
        android:layout_height="29dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="68dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        android:background="@drawable/search_input_background"
        android:hint="Search for a destination..."
        android:textSize="16sp"
        android:textColor="#FF1A1A1A"
        android:textColorHint="#6B7280"
        android:paddingHorizontal="12dp"
        android:paddingVertical="0dp"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:singleLine="true" />

    <ImageButton
        android:id="@+id/search_button"
        android:scaleType="fitCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="272dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_search"
        android:background="@drawable/icon_backdrop"
        android:padding="4dp"
        android:contentDescription="Search for an address"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

    <!-- Search suggestions (Photon), opening upwards over the search bar. -->
    <ScrollView
        android:id="@+id/search_results_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="186dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="54dp"
        android:background="@drawable/popup_background"
        android:elevation="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/search_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp" />

    </ScrollView>

    <!-- Map credit, always visible (OpenStreetMap ODbL + OpenMapTiles
         CC-BY require it). Tap for all credits and links. -->
    <TextView
        android:id="@+id/credit_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="2dp"
        android:background="@drawable/credit_background"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:text="\u00a9 OpenStreetMap contributors \u00a9 OpenMapTiles"
        android:textColor="@color/credit_text"
        android:textSize="10sp" />

</FrameLayout>
