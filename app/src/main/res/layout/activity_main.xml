<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Turn-by-turn guidance bar: icon + text, dark solid background. -->
    <LinearLayout
        android:id="@+id/nav_instruction_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/nav_bar_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/nav_instruction_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/nav_icon_backdrop"
            android:padding="4dp"
            android:src="@drawable/ic_nav_straight"
            android:visibility="gone" />

        <TextView
            android:id="@+id/nav_distance_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.01" />

        <TextView
            android:id="@+id/status_strip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:maxLines="2"
            android:ellipsize="end"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.01" />

    </LinearLayout>

    <!-- ===== ZONE: top row, trip setup (walk/bike/car + rule
         modifiers, all in one row ending before the locate icon) ===== -->

    <LinearLayout
        android:id="@+id/mode_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="113dp"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <!-- 68dp frame pulled 30dp left: car at 30dp in, toll in the extra
             space on its left (tappable). Gaps car|urgency|poi are equal. -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="38dp"
            android:layout_marginStart="-30dp">

            <ImageButton
                android:id="@+id/mode_toggle_button"
                android:scaleType="fitCenter"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="start"
                android:layout_marginStart="30dp"
                android:src="@drawable/ic_mode_walking"
                android:background="@drawable/icon_backdrop"
                android:padding="4dp"
                android:contentDescription="Travel mode"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

            <ImageButton
                android:id="@+id/toll_toggle"
                android:scaleType="fitCenter"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="start|center_vertical"
                android:src="@drawable/ic_toll_on"
                android:background="@drawable/icon_backdrop"
                android:padding="3dp"
                android:contentDescription="@string/avoid_tolls_label"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:visibility="gone" />

        </FrameLayout>

        <Space
            android:layout_width="32dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/urgency_button"
            android:scaleType="fitCenter"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_urgency_weekend"
            android:background="@drawable/icon_backdrop"
            android:padding="4dp"
            android:contentDescription="@string/urgency_label"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

        <Space
            android:layout_width="32dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/poi_toggle_button"
            android:scaleType="fitCenter"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_poi_toggle"
            android:background="@drawable/icon_backdrop"
            android:padding="4dp"
            android:contentDescription="Points of interest"
            android:elevation="0dp"
            android:stateListAnimator="@null" />


    </LinearLayout>

    <!-- ===== ZONE: right column ===== -->

    <!-- 1: search, alone in the very top-right corner -->
    <ImageButton
        android:id="@+id/search_button"
        android:scaleType="fitCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_search"
        android:background="@drawable/icon_backdrop"
        android:padding="4dp"
        android:contentDescription="Search for an address"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

    <!-- Rounded, fainted search box, always visible now, sits to the
         left of the magnifier at the same height. The message bubble
         shares this row (left of the magnifier too) rather than a
         separate area, for now. -->
    <EditText
        android:id="@+id/search_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="60dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="54dp"
        android:background="@drawable/search_input_background"
        android:hint="Search for a destination..."
        android:textSize="16sp"
        android:textColor="#FF1A1A1A"
        android:textColorHint="#6B7280"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:singleLine="true" />

    <!-- 2: center on my location -->
    <ImageButton
        android:id="@+id/locate_button"
        android:scaleType="fitCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="113dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_location_marker"
        android:background="@drawable/icon_backdrop"
        android:padding="4dp"
        android:contentDescription="@string/locate_button_label"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

    <!-- 3: add a stop -->
    <ImageButton
        android:id="@+id/waypoint_button"
        android:scaleType="fitCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="166dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_waypoint"
        android:background="@drawable/icon_backdrop"
        android:padding="4dp"
        android:contentDescription="Add a stop along the route"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

    <!-- 4-6: route preference, single cycling toggle -->
    <ImageButton
        android:id="@+id/preference_toggle_button"
        android:scaleType="fitCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="219dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_pref_fastest"
        android:background="@drawable/icon_backdrop"
        android:padding="4dp"
        android:contentDescription="Route preference"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

    <!-- Route options (avoid motorways/ferries/steps, bike type, hills...) -->
    <ImageButton
        android:id="@+id/route_options_button"
        android:scaleType="fitCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="272dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_route_options"
        android:background="@drawable/icon_backdrop"
        android:padding="6dp"
        android:contentDescription="Route options"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

    <!-- During navigation: look for another route from where you are. -->
    <ImageButton
        android:id="@+id/alt_route_button"
        android:scaleType="fitCenter"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="272dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_alt_route"
        android:background="@drawable/icon_backdrop"
        android:padding="6dp"
        android:contentDescription="Find an alternative route"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:visibility="gone" />

    <!-- Alternative route chips, stacked vertically below the
         preference toggle. Background color (not text color) shows
         which one is primary, to avoid the confusing "text swaps
         color" effect from before. -->
    <LinearLayout
        android:id="@+id/route_options_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="325dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- ===== ZONE: top-center, transient messages ===== -->

    <TextView
        android:id="@+id/message_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/message_bubble_background"
        android:textColor="@color/backpack_ink"
        android:textSize="15sp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:maxLines="2"
        android:maxWidth="260dp"
        android:ellipsize="end"
        android:alpha="0"
        android:visibility="invisible" />

    <!-- Errors get their own spot, separate from routine confirmation
         messages, positioned at runtime, 25% of screen height up
         from the bottom (device-relative, so it's computed in code
         rather than a fixed dp margin). -->
    <TextView
        android:id="@+id/error_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/message_bubble_background"
        android:textColor="@color/backpack_ink"
        android:textSize="15sp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:maxLines="2"
        android:maxWidth="260dp"
        android:ellipsize="end"
        android:alpha="0"
        android:visibility="invisible" />

    <!-- ===== ZONE: bottom-left, settings (swapped with speed sign) ===== -->


    <!-- ===== ZONE: bottom-right, live driving info ===== -->


    <!-- ===== ZONE: bottom-center, route result + primary action ===== -->

    <LinearLayout
        android:id="@+id/route_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="108dp"
        android:orientation="horizontal"
        android:background="@drawable/route_info_background"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/route_info_dist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:text=""
            android:textColor="#F0F0F0"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/route_info_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:text=""
            android:textColor="#F0F0F0"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/route_info_cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#F0F0F0"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

    </LinearLayout>



    <!-- ===== ZONE: bottom bar: 4 equal slots (settings | clear | go | speed),
         centres 48dp above the bottom; empty slots keep their place. ===== -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false">

            <ImageButton
                android:id="@+id/settings_button"
                android:scaleType="fitCenter"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                android:background="@drawable/icon_backdrop"
                android:padding="4dp"
                android:contentDescription="Settings"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false">

            <ImageButton
                android:id="@+id/clear_route_button"
                android:scaleType="fitCenter"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_clear_route"
                android:background="@drawable/icon_backdrop"
                android:padding="6dp"
                android:contentDescription="Clear route"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false">

            <ImageButton
                android:id="@+id/nav_go_button"
                android:scaleType="fitCenter"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_navigation_go"
                android:background="@drawable/icon_backdrop"
                android:padding="8dp"
                android:contentDescription="Start navigation"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false">

                <!-- Current speed circle (ring colour = speed vs limit, same rules as
             before) with the road's speed-limit sign on top of it. -->
        <FrameLayout
            android:id="@+id/speed_widget"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="bottom|center_horizontal"
            android:clipChildren="false"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/speed_sign"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/speed_sign_background"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/speed_sign_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="#FF1A1A1A"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/speed_unit_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="km/h"
                    android:textColor="#FF555555"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- Speed-limit sign: white, red ring, black number. Hidden when the
                 road's limit is unknown. -->
            <TextView
                android:id="@+id/speed_limit_sign"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:background="@drawable/speed_limit_background"
                android:elevation="2dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="#FF000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </FrameLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Search suggestions (Photon), under the search box. -->
    <ScrollView
        android:id="@+id/search_results_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="100dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="54dp"
        android:background="@drawable/popup_background"
        android:elevation="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/search_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp" />

    </ScrollView>

    <!-- Map credit, always visible (OpenStreetMap ODbL + OpenMapTiles
         CC-BY require it). Tap for all credits and links. -->
    <TextView
        android:id="@+id/credit_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="2dp"
        android:background="@drawable/credit_background"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:text="\u00a9 OpenStreetMap contributors \u00a9 OpenMapTiles"
        android:textColor="@color/credit_text"
        android:textSize="10sp" />

</FrameLayout>
