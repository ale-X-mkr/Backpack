<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rg_window_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/settings_title"
            android:text="SETTINGS"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/rg_text"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISPLAY"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textColor="@color/rg_text_secondary" />

        <!-- Sunset = night map from sunset to sunrise at your position. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

        <RadioGroup
            android:id="@+id/display_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp">

            <RadioButton
                android:id="@+id/display_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day"
                android:textSize="15sp"
                android:textColor="@color/rg_text"
                android:buttonTint="@color/rg_active"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/display_night"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Night"
                android:textSize="15sp"
                android:textColor="@color/rg_text"
                android:buttonTint="@color/rg_active"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/display_auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sunset"
                android:textSize="15sp"
                android:textColor="@color/rg_text"
                android:buttonTint="@color/rg_active" />

            <RadioButton
                android:id="@+id/display_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System"
                android:textSize="15sp"
                android:textColor="@color/rg_text"
                android:buttonTint="@color/rg_active"
                android:layout_marginStart="16dp" />

        </RadioGroup>

        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAP STYLE (DAY)"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textColor="@color/rg_text_secondary" />

        <RadioGroup
            android:id="@+id/style_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp">

            <RadioButton
                android:id="@+id/style_liberty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Liberty"
                android:textSize="15sp"
                android:textColor="@color/rg_text"
                android:buttonTint="@color/rg_active"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/style_bright"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bright"
                android:textSize="15sp"
                android:textColor="@color/rg_text"
                android:buttonTint="@color/rg_active"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/style_positron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Light grey"
                android:textSize="15sp"
                android:textColor="@color/rg_text"
                android:buttonTint="@color/rg_active" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Maps by OpenFreeMap (no account, no key, no cookies). Night always uses the dark map."
            android:textSize="11sp"
            android:textColor="@color/rg_text_secondary"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISTANCE UNIT"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textColor="@color/rg_text_secondary" />

        <RadioGroup
            android:id="@+id/unit_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp">

            <RadioButton
                android:id="@+id/unit_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kilometers"
                android:textSize="15sp"
                android:textColor="@color/rg_text"
                android:buttonTint="@color/rg_active"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/unit_mi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Miles"
                android:textSize="15sp"
                android:textColor="@color/rg_text"
                android:buttonTint="@color/rg_active" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIME VALUE (EUR/HOUR) -- Weekend / Work / Emergency"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textColor="@color/rg_text_secondary"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <EditText
                android:id="@+id/value_weekend"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/rg_active"
                android:backgroundTint="@color/rg_active"
                android:layout_marginEnd="12dp" />

            <EditText
                android:id="@+id/value_work"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/rg_active"
                android:backgroundTint="@color/rg_active"
                android:layout_marginEnd="12dp" />

            <EditText
                android:id="@+id/value_emergency"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/rg_active"
                android:backgroundTint="@color/rg_active" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOLL ESTIMATE (EUR/KM)"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textColor="@color/rg_text_secondary"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/toll_rate"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/rg_active"
            android:backgroundTint="@color/rg_active"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAP LAYERS"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textColor="@color/rg_text_secondary"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Default POI category on launch"
            android:textSize="13sp"
            android:textColor="@color/rg_text_secondary"
            android:layout_marginTop="4dp" />

        <RadioGroup
            android:id="@+id/default_poi_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/default_poi_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Off"
                android:textSize="15sp"
                android:textColor="@color/rg_text"
                android:buttonTint="@color/rg_active" />

            <RadioButton
                android:id="@+id/default_poi_fuel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fuel/Charging"
                android:textSize="15sp"
                android:textColor="@color/rg_text"
                android:buttonTint="@color/rg_active" />

            <RadioButton
                android:id="@+id/default_poi_food"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food"
                android:textSize="15sp"
                android:textColor="@color/rg_text"
                android:buttonTint="@color/rg_active" />

            <RadioButton
                android:id="@+id/default_poi_emergency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency"
                android:textSize="15sp"
                android:textColor="@color/rg_text"
                android:buttonTint="@color/rg_active" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sets which POI category the app starts with (still overridden by what you pick during a session, and by Emergency mode)."
            android:textSize="11sp"
            android:textColor="@color/rg_text_secondary"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADVANCED (LEAVE EMPTY FOR DEFAULTS)"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textColor="@color/rg_text_secondary"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/ors_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Routing server (default api.openrouteservice.org)"
            android:inputType="textUri"
            android:textSize="14sp"
            android:textColor="@color/rg_text"
            android:textColorHint="@color/rg_text_secondary"
            android:backgroundTint="@color/rg_active" />

        <EditText
            android:id="@+id/ors_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Own openrouteservice key"
            android:inputType="textNoSuggestions"
            android:textSize="14sp"
            android:textColor="@color/rg_text"
            android:textColorHint="@color/rg_text_secondary"
            android:backgroundTint="@color/rg_active" />

        <EditText
            android:id="@+id/custom_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Own map style URL (day)"
            android:inputType="textUri"
            android:textSize="14sp"
            android:textColor="@color/rg_text"
            android:textColorHint="@color/rg_text_secondary"
            android:backgroundTint="@color/rg_active"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE"
            android:textSize="16sp"
            android:letterSpacing="0.08"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="@color/rg_active" />

    </LinearLayout>

</ScrollView>
