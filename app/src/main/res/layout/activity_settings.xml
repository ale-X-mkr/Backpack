<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B8BCC0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTROLS"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="#1A1D21"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISPLAY"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textColor="#3A3D40" />

        <RadioGroup
            android:id="@+id/display_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp">

            <RadioButton
                android:id="@+id/display_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day"
                android:textSize="15sp"
                android:textColor="#1A1D21"
                android:buttonTint="#2B6CB0"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/display_night"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Night"
                android:textSize="15sp"
                android:textColor="#1A1D21"
                android:buttonTint="#2B6CB0"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/display_auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto"
                android:textSize="15sp"
                android:textColor="#1A1D21"
                android:buttonTint="#2B6CB0" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISTANCE UNIT"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textColor="#3A3D40" />

        <RadioGroup
            android:id="@+id/unit_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp">

            <RadioButton
                android:id="@+id/unit_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kilometers"
                android:textSize="15sp"
                android:textColor="#1A1D21"
                android:buttonTint="#2B6CB0"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/unit_mi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Miles"
                android:textSize="15sp"
                android:textColor="#1A1D21"
                android:buttonTint="#2B6CB0" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIME VALUE (EUR/HOUR) -- Weekend / Work / Emergency"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textColor="#3A3D40"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <EditText
                android:id="@+id/value_weekend"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2B6CB0"
                android:backgroundTint="#2B6CB0"
                android:layout_marginEnd="12dp" />

            <EditText
                android:id="@+id/value_work"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2B6CB0"
                android:backgroundTint="#2B6CB0"
                android:layout_marginEnd="12dp" />

            <EditText
                android:id="@+id/value_emergency"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2B6CB0"
                android:backgroundTint="#2B6CB0" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOLL ESTIMATE (EUR/KM)"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textColor="#3A3D40"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/toll_rate"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2B6CB0"
            android:backgroundTint="#2B6CB0"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAP LAYERS"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textColor="#3A3D40"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Default POI category on launch"
            android:textSize="13sp"
            android:textColor="#3A3D40"
            android:layout_marginTop="4dp" />

        <RadioGroup
            android:id="@+id/default_poi_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/default_poi_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Off"
                android:textSize="15sp"
                android:textColor="#1A1D21"
                android:buttonTint="#2B6CB0" />

            <RadioButton
                android:id="@+id/default_poi_fuel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fuel/Charging"
                android:textSize="15sp"
                android:textColor="#1A1D21"
                android:buttonTint="#2B6CB0" />

            <RadioButton
                android:id="@+id/default_poi_food"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food"
                android:textSize="15sp"
                android:textColor="#1A1D21"
                android:buttonTint="#2B6CB0" />

            <RadioButton
                android:id="@+id/default_poi_emergency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency"
                android:textSize="15sp"
                android:textColor="#1A1D21"
                android:buttonTint="#2B6CB0" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note: this sets which POI category the app starts with each time (still overridden by whatever you pick during a session, and by Emergency mode auto-switching). The base map's own detail -- road labels, place names baked into the tiles -- can't be filtered with the current map source; that would need a different tile provider, not a setting."
            android:textSize="11sp"
            android:textColor="#5A6169"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE"
            android:textSize="16sp"
            android:letterSpacing="0.08"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2B6CB0" />

    </LinearLayout>

</ScrollView>
