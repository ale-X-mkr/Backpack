<!-- 1.8.0: the next-action circle: dark disc, white ring with a thin black
     edge (visible on light and dark maps), as big as the speed circle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF000000" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#E6202020" />
            <stroke android:width="4dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
